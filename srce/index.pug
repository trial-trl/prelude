//head#
//#title
if title 
|#{title}
| TRIAL
//title#
header#header
    #header-bg
    #header-wrap
    a(href='/' data-add-class='default')#the-brand
        trl-logo(trl-compact='true' trl-scale='.33' trl-color='#fff')
    #header-wrap-bottom
        input(type="checkbox")#page-theme-toggle
        #header-search
        input(type='search' placeholder='Pesquisar...')
        i.fas.fa-search
        nav#main-menu
        a(data-add-class='techgames')
            | Tecnologia 
            br
            | &amp; Games
        a(data-add-class='design') Design
        a(data-add-class='marketing') Marketing
    #header-social-links
    a(href='')
        img(src='images/FB_icon.svg')
    a(href='')
        img(src='images/IG_icon.svg')
    a(href='')
        img(src='images/TW_icon.svg')
div(data-router-outlet="true" data-unit=initialUnit)
div(data-unit="footer")