mixin project()
    .project
        .project__main
            img
            .skew
                .shape
                hgroup
                    h2 SuperMassagem
                    h3 React Native
        .project__hover
            .project__hover--patterns
                | WCAG 2.1
            .project__hover--banner
                .language 80%
                .language 10%
                .language 7%
                .language 3%

#portfolio
    #portfolio__title
        img
        h1 #{params.cat}
    #portfolio__projects
        +project()