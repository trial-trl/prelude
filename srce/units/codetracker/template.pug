mixin counter(type, label, value)
    a.stats(href="/portfolio")
        h1.color-primary(id="codetracker__" + type)= value
        h5= label

#codetracker
    +counter('clients', 'clientes', 20)
    +counter('projects', 'projetos', 20)
    if loading 
        +counter('repos', 'repositórios', 0)
    else
        +counter('repos', 'repositórios', api.data.repositories)
    if loading 
        +counter('codelines', 'linhas de código', 0)
    else
        +counter('codelines', 'linhas de código', api.data.util)